# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
__pycache__/
*.pyc

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Nunca committear el keystore de firma
*.jks
*.keystore
key.properties

# Ficheros fuente de ingesta (Excel, PDFs, cuadernillos, JSON
# intermedios) — nunca en git. EXCEPCIÓN: los insert_*.sql/update_*.sql
# ya aplicados en producción, y los scripts/package que los generaron,
# SÍ se versionan (valor de auditoría permanente: qué se cargó/modificó
# en pir-db y con qué criterio/código).
/ingesta/*
!/ingesta/*/
/ingesta/*/*
!/ingesta/*/insert_*.sql
!/ingesta/*/update_*.sql
!/ingesta/update_*.sql
!/ingesta/generar_explicaciones.mjs
!/ingesta/generar_update_explicaciones.mjs
!/ingesta/package.json
!/ingesta/package-lock.json

# Credenciales de prueba, nunca en git
credenciales_test.txt

# Claude Code: checkpoint de sesión, no es código del proyecto
.claude/RESUME.md
