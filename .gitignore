key.properties

# Ficheros fuente de ingesta (Excel, PDFs, cuadernillos, scripts y
# JSON intermedios) — nunca en git. EXCEPCIÓN: los insert_*.sql ya
# aplicados en producción SÍ se versionan (valor de auditoría
# permanente: qué se cargó en pir-db y con qué criterio).
/ingesta/*
!/ingesta/*/
/ingesta/*/*
!/ingesta/*/insert_*.sql

